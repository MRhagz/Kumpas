# Copy to .env.local and fill every required key. Never commit real credentials.
# All Gemini keys belong to the same billing-enabled Google Cloud project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENT_INTAKE_API_KEY=
ACADEMIC_AUDITOR_API_KEY=
INDUSTRY_ANALYST_API_KEY=
FEASIBILITY_STRATEGIST_API_KEY=
SYNTHESIS_API_KEY=

# Approved provider contract. Unsupported values prevent startup.
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_API_VERSION=v1beta
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Separate existing lifecycle and privacy configuration.
REPORT_RETENTION_SECRET=
SESSION_CLEANUP_SECRET=
# GitHub Actions variable for the authenticated retention runner (HTTPS origin).
KUMPAS_APP_URL=
NEXT_PUBLIC_SCHOOL_PRIVACY_CONTACT=
