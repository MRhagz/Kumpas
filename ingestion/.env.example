# Export these variables before running a pipeline; Python does not load .env files.
# Use GitHub Actions secrets in CI. Never commit actual keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Project-signed, unexpired JWT with role ingestion_worker. Never use a service-role key.
SUPABASE_INGESTION_TOKEN=
GEMINI_API_KEY=
GEMINI_API_VERSION=v1beta
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Only set development when intentionally using a local Supabase HTTP endpoint.
KUMPAS_ENV=production
